# Database (Required for Vercel / Server)
DATABASE_URL=

# Cryptographic session secret (Required for Vercel / Server)
SESSION_SECRET=

# Multi-factor authentication secret (Required if using MFA)
MFA_SECRET_KEY=

# App Origin (Required for Vercel / Server to allow CORS/CSRF)
APP_ORIGIN=https://your-vercel-app.vercel.app

# Default seed password for local development and initial seeding
BCCAA_SEED_PASSWORD=
